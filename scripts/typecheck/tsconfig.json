{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "types": [],
    "paths": { "@/*": ["../../src/*"] }
  },
  "files": ["stubs.d.ts"],
  "include": ["../../src/**/*.ts", "../../src/**/*.tsx"]
}
