# Copy to .env.local for local development. On Cloudflare, set these with `npx wrangler secret put NAME`
# (NEXT_PUBLIC_* values must also be present at build time — add them in Cloudflare > Workers > Settings > Build variables).

# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=https://styile.com
# Each salon gets <slug>.styile.com. Leave empty to use styile.com/s/<slug> paths instead (local dev without subdomains).
# For local subdomains use localhost:3000 and open http://glowstudio.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=styile.com
NEXT_PUBLIC_APP_NAME=Styile
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.in
CRON_SECRET=long-random-string

# --- WhatsApp Cloud API (Meta for Developers > your app) ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=any-random-string-you-also-type-into-meta
# Token of the system user in your Meta Business that manages salons' WhatsApp accounts.
# A salon-specific token in salon_secrets overrides this.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Phone number id of YOUR platform number, used to send login codes to customers.
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=login_code

# --- Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Supabase auth hook (Authentication > Hooks > Send SMS hook > HTTPS) ---
# Supabase shows the secret as "v1,whsec_..." — paste it here exactly.
SUPABASE_SMS_HOOK_SECRET=
